/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zenith",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/server.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"exports": {
		"ChatRunDO": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_RUN",
				"class_name": "ChatRunDO"
			}
		]
	},
	/**
	 * Secrets (local): put in `.dev.vars` — GEMINI_API_KEY, QDRANT_URL, QDRANT_API_KEY.
	 * Production: `wrangler secret put GEMINI_API_KEY` etc.
	 */
	"vars": {
		"QDRANT_COLLECTION": "bd_laws_v1"
	}
}
